{
  "name": "gitglance",
  "version": "0.1.0",
  "description": "Analyze git repositories: activity stats, health checks, changelogs and AI summaries",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gitglance": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysohaarsh/gitglance.git"
  },
  "homepage": "https://github.com/ysohaarsh/gitglance#readme",
  "bugs": {
    "url": "https://github.com/ysohaarsh/gitglance/issues"
  }
}
